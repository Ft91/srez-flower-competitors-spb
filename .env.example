# Choose openai or proxyapi. Leave the unused key empty.
AI_PROVIDER=openai
OPENAI_API_KEY=
PROXY_API_KEY=
# Blank = gpt-4.1-mini for OpenAI, openai/gpt-4.1-mini for ProxyAPI.
TEXT_MODEL=
IMAGE_MODEL=
REQUEST_TIMEOUT_SECONDS=60
MAX_OUTPUT_TOKENS=6000

# Optional: installed Google Chrome and matching ChromeDriver. Blank = auto-detect.
CHROME_BINARY=
CHROME_DRIVER=
PAGE_TIMEOUT_SECONDS=35
